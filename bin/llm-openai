#!/usr/bin/env python3
"""LLM runner for OpenAI API.

Reads prompt from stdin, outputs response to stdout.
Requires OPENAI_API_KEY environment variable.
"""

import argparse
import json
import os
import sys
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser(description="OpenAI LLM runner")
    parser.add_argument("--system", help="System prompt")
    parser.add_argument("--temperature", type=float, default=0.7, help="Sampling temperature")
    parser.add_argument("--max-tokens", type=int, default=4096, help="Maximum tokens to generate")
    parser.add_argument("--model", default="gpt-4o", help="Model to use")
    parser.add_argument("--endpoint", help="API base URL (overrides OPENAI_BASE_URL)")
    parser.add_argument("--api-version", help="API version (ignored for OpenAI)")
    parser.add_argument("--descriptor", action="store_true", help="Print Boutiques descriptor and exit")
    args = parser.parse_args()

    if args.descriptor:
        descriptor_path = Path(__file__).parent / "llm-runner.boutiques.json"
        print(descriptor_path.read_text(), end="")
        sys.exit(0)

    # Check for API key
    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        print("Error: OPENAI_API_KEY environment variable not set", file=sys.stderr)
        sys.exit(1)

    # Get base URL from argument or environment
    base_url = args.endpoint or os.environ.get("OPENAI_BASE_URL")

    # Read prompt from stdin
    prompt = sys.stdin.read().strip()
    if not prompt:
        print("Error: No prompt provided on stdin", file=sys.stderr)
        sys.exit(1)

    try:
        import openai
    except ImportError:
        print("Error: openai package not installed", file=sys.stderr)
        print("Install with: pip install openai", file=sys.stderr)
        sys.exit(1)

    # Create client and make request
    client_kwargs = {"api_key": api_key}
    if base_url:
        client_kwargs["base_url"] = base_url
    client = openai.OpenAI(**client_kwargs)

    messages = []
    if args.system:
        messages.append({"role": "system", "content": args.system})
    messages.append({"role": "user", "content": prompt})

    def _call(**kwargs):
        response = client.chat.completions.create(**kwargs)
        if response.choices and response.choices[0].message.content:
            print(response.choices[0].message.content)

    kwargs = dict(model=args.model, messages=messages)

    # Try max_completion_tokens first (required by newer models like gpt-5.1),
    # fall back to max_tokens for older models.
    for token_param in ("max_completion_tokens", "max_tokens"):
        try:
            _call(**kwargs, temperature=args.temperature, **{token_param: args.max_tokens})
            return
        except openai.APIError as e:
            err = str(e)
            if "unsupported_parameter" in err.lower() and token_param == "max_completion_tokens":
                continue  # retry with max_tokens
            if "does not support" in err.lower() and "temperature" in err.lower():
                # Model only supports default temperature — retry without it
                try:
                    _call(**kwargs, **{token_param: args.max_tokens})
                    return
                except openai.APIError as e2:
                    err2 = str(e2)
                    if "unsupported_parameter" in err2.lower() and token_param == "max_completion_tokens":
                        continue  # retry with max_tokens
                    print(f"API Error: {e2}", file=sys.stderr)
                    sys.exit(1)
            print(f"API Error: {e}", file=sys.stderr)
            sys.exit(1)

    print("Error: could not find working parameter combination", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
